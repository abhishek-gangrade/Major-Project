# AdaptivePrep Backend Configuration
PROJECT_NAME=AdaptivePrep
API_V1_STR=/api/v1
ENVIRONMENT=development

# Security
SECRET_KEY=adaptiveprep-super-secret-development-key-change-in-prod-xyz123
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Database
# Default SQLite local development URL:
DATABASE_URL=sqlite:///./adaptiveprep.db

# Production PostgreSQL URL:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/adaptiveprep

# CORS Allowed Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://localhost:8000"]

# Recommendation Engine Weights (S = 100 * (0.45A + 0.25R + 0.20D + 0.10E))
WEIGHT_ACCURACY=0.45
WEIGHT_RECENCY=0.25
WEIGHT_DIFFICULTY=0.20
WEIGHT_EFFICIENCY=0.10

# Thresholds
THRESHOLD_EASY_UPPER=40.0
THRESHOLD_MEDIUM_UPPER=70.0
RECENCY_WINDOW_SIZE=5
MIN_OBSERVATION_THRESHOLD=3
ALGORITHM_VERSION=v1.0.0-multi-factor

